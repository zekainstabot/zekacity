current = true
script = ExtResource( 2 )

[node name="UI" type="CanvasLayer" parent="."]

[node name="ConstructionButton" type="Button" parent="UI"]
margin_right = 180.0
margin_bottom = 50.0
text = "Construction"

[node name="ConstructionMenu" type="PopupMenu" parent="UI"]
